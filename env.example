# Copy to .env (or export as real environment variables) and fill in real
# values. Never commit a filled-in .env file - add .env to .gitignore first.

# --- Database A ----------------------------------------------------------
DB_A_USERNAME=
DB_A_PASSWORD=
# DSN as host:port/service_name, a full easy-connect string, or a tnsnames.ora alias
DB_A_DSN=
# Optional: default schema/owner applied to unqualified table names on this
# side (overridden by --db-a-schema, and by any explicit OWNER.TABLE entry
# in the table list). Leave blank to use the connection's own default schema.
DB_A_SCHEMA=

# --- Database B ----------------------------------------------------------
DB_B_USERNAME=
DB_B_PASSWORD=
DB_B_DSN=
DB_B_SCHEMA=
